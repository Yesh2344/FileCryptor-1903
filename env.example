# .env.example
# Copy this file to .env and set the values.

# 32‑byte (256‑bit) key encoded in Base64.
# Example generation (run in Ruby):
#   require 'securerandom'; puts Base64.strict_encode64(SecureRandom.random_bytes(32))
ENCRYPTION_KEY=YOUR_BASE64_ENCODED_KEY_HERE

# Logging level (debug, info, warn, error, fatal)
LOG_LEVEL=info